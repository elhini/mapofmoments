{
    "name": "mapofmoments",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build --turbopack",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "stylelint": "stylelint \"**/*.css\"",
        "stylelint:fix": "stylelint \"**/*.css\" --fix",
        "prettier": "prettier --check .",
        "prettier:fix": "prettier --write .",
        "prepare": "husky",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:ci": "vitest run"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.56.1",
        "@tanstack/react-query": "^5.59.16",
        "mapbox-gl": "^3.14.0",
        "next": "15.5.2",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^5.0.2",
        "@vitest/ui": "^3.2.4",
        "eslint": "^9",
        "eslint-config-next": "15.5.2",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.1.5",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "stylelint": "^16",
        "stylelint-config-standard": "^36",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
